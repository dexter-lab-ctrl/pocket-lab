      ],
      "evidenceEvents": [
        "pocketlab.events.runbook.auto_approved",
        "pocketlab.audit.runbook.auto_approved",
        "pocketlab.audit.runbook.approved",
        "pocketlab.audit.runbook.rejected"
      ],
      "id": "adaptive-runbook-approval",
      "mode": "decision",
      "package": "pocketlab.approval",
      "severity": "high",
      "simpleSummary": "Lets safe home-lab actions continue automatically, while Enterprise Mode requires a person to approve important changes.",
      "source": "security/policies/pocketlab-policy-bundle.yaml",
      "summary": "Preserves Personal Mode auto-approval evidence and Enterprise Mode strict human authorization for approval-gated runbooks.",
      "title": "Adaptive Runbook Approval"
    },
    {
      "appliesTo": {
        "operations": [
          "rotate_secret",
          "secret_read_dynamic",
          "deploy_blueprint",
          "security_scan"
        ],
        "runbooks": [
          "rotate_secret_with_audit"
        ]
      },
      "controls": [
        "PL-CTRL-001",
        "PL-CTRL-003",
        "PL-CTRL-004"
      ],
      "evidenceEvents": [
        "pocketlab.events.vault.secret_rotated",
        "pocketlab.audit.vault.secret_rotated",
        "pocketlab.events.security.finding"
      ],
      "id": "hardcoded-secrets-prevention",
      "mode": "enforceable",
      "package": "pocketlab.security",
      "rego": "package pocketlab.security\n\ndeny[msg] {\n    some key\n    val := input.playbook.vars[key]\n    contains(lower(key), \"password\")\n    not contains(val, \"lookup('hashi_vault'\")\n    msg := \"Hardcoded secrets detected. You must use the Vault AppRole lookup plugin.\"\n}\n",
      "severity": "high",
      "simpleSummary": "Keeps passwords and tokens out of app setup files.",
      "source": "security/policies/pocketlab-policy-bundle.yaml",
      "summary": "Requires secret handling through Vault / OpenBao lookup paths instead of plaintext playbook variables.",
      "title": "Hardcoded Secrets Prevention"
    },
    {
      "appliesTo": {
        "operations": [
          "deploy_blueprint",
          "health_check",
          "security_scan"
        ],
        "runbooks": [
          "recover_failed_install"
        ]
      },
      "controls": [
        "PL-CTRL-001",
        "PL-CTRL-004"
      ],
      "evidenceEvents": [
        "pocketlab.events.security.finding",
        "pocketlab.audit.security.policy_updated"
      ],
      "id": "privileged-port-restriction",
      "mode": "enforceable",
      "package": "pocketlab.network",
      "rego": "package pocketlab.network\n\ndeny[msg] {\n    port := input.playbook.tasks[_].pm2_env.PORT\n    to_number(port) < 1024\n    msg := \"Android OS denies non-root binding to ports < 1024. Please use a port > 1023.\"\n}\n",
      "severity": "critical",
      "simpleSummary": "Keeps apps from using restricted phone ports that would fail on Android.",
      "source": "security/policies/pocketlab-policy-bundle.yaml",
      "summary": "Prevents workloads from binding to privileged ports below 1024 on Android / Termux targets.",
      "title": "Privileged Port Restriction"
    },
    {
      "appliesTo": {
        "operations": [
          "deploy_blueprint",
          "release_apply",
          "restore_backup"
        ],
        "runbooks": [
          "recover_failed_install",
          "release_rollback",
          "backup_restore_verify"
        ]
      },
      "controls": [
        "PL-CTRL-001",
        "PL-CTRL-004"
      ],
      "evidenceEvents": [
        "pocketlab.events.security.finding"
      ],
      "id": "proot-isolation-enforcement",
      "mode": "audit",
      "package": "pocketlab.execution",
      "rego": "package pocketlab.execution\n\ndeny[msg] {\n    task := input.playbook.tasks[_]\n    contains(task.command, \"apt-get\")\n    not contains(task.prefix, \"proot-distro login ubuntu\")\n    msg := \"Linux package managers must be executed inside the PRoot Ubuntu subsystem.\"\n}\n",
      "severity": "medium",
      "simpleSummary": "Keeps advanced Linux commands inside the safe Linux container area on Android.",
      "source": "security/policies/pocketlab-policy-bundle.yaml",
      "summary": "Ensures Linux package manager actions run inside the PRoot Ubuntu subsystem instead of native Termux.",
      "title": "PRoot Isolation Enforcement"
    }
  ],
