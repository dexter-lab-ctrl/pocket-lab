#!/usr/bin/env bash
set -euo pipefail

BACKUP_ROOT="{{ backup_root }}"
RETENTION_DAYS="{{ backup_retention_days }}"
STAMP="$(date +%Y%m%d-%H%M%S)"
RUN_DIR="${BACKUP_ROOT}/${STAMP}"
mkdir -p "${RUN_DIR}"

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

backup_dir() {
  local name="$1"
  local path="$2"
  if [ -d "$path" ]; then
    tar -C "$(dirname "$path")" -czf "${RUN_DIR}/${name}.tar.gz" "$(basename "$path")"
  fi
}

# 1. File-based backups (Playbooks, Configurations, Caddy certs, Vault Unseal Keys)
{% for target in backup_targets %}
backup_dir "{{ target.name }}" "{{ target.path }}"
{% endfor %}

# 2. Database backups (Gitea and Vault)
if command -v mariadb-dump >/dev/null 2>&1 && [ -S "{{ mariadb_socket | default(common_base_dir ~ '/mariadb/mysqld.sock') }}" ]; then
  # Execute dump using injected credentials instead of root
  mariadb-dump \
    --protocol=socket \
    -u"{{ mariadb_backup_user | default('pocket_admin') }}" \
    -p"{{ mariadb_backup_password }}" \
    -S "{{ mariadb_socket | default(common_base_dir ~ '/mariadb/mysqld.sock') }}" \
    --databases gitea vault > "${RUN_DIR}/mariadb.sql"
fi

# 3. Compress the final archive
tar -czf "${BACKUP_ROOT}/pocket-lab-${STAMP}.tar.gz" -C "${RUN_DIR}" .

# 4. Clean up uncompressed run directory to save storage space
rm -rf "${RUN_DIR}"

# 5. Purge backups older than RETENTION_DAYS
find "${BACKUP_ROOT}" -maxdepth 1 -type f -name 'pocket-lab-*.tar.gz' -mtime +"${RETENTION_DAYS}" -delete || true
log "Backup complete: ${BACKUP_ROOT}/pocket-lab-${STAMP}.tar.gz"
