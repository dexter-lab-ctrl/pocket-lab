log:
  level: info

runner:
  file: .runner
  capacity: 1
  envs:
    # Explicitly load the AppRole credentials from the .env file generated by Ansible
    VAULT_ROLE_ID: ${VAULT_ROLE_ID}
    VAULT_SECRET_ID: ${VAULT_SECRET_ID}
    VAULT_ADDR: "http://127.0.0.1:8200"

cache:
  enabled: false

container:
  # Disables Docker requirement; forces native host execution
  network: ""
  enable_ipv6: false
