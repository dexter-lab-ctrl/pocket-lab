#!/usr/bin/env python3
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os

PORT = int(os.environ.get("DASHBOARD_API_PORT", "{{ dashboard_api_port }}"))
ENV_NAME = os.environ.get("POCKET_LAB_ENV", "{{ env_name }}")

SERVICES = {
    "vault": "http://127.0.0.1:8200/v1/sys/health",
    "gitea": "http://127.0.0.1:3030/api/healthz",
    "semaphore": "http://127.0.0.1:3000/", # Corrected Semaphore Port
    "caddy": "http://127.0.0.1:{{ caddy_public_port | default('8443') }}/healthz",
}

class Handler(BaseHTTPRequestHandler):
    server_version = "PocketLabDashboard/1.0"

    def _send(self, status, payload):
        data = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "{{ dashboard_health_path }}"):
            self._send(200, {"status": "ok", "service": "dashboard-api", "env": ENV_NAME})
            return
        if self.path == "/api/status":
            self._send(200, {
                "status": "ok",
                "env": ENV_NAME,
                "api_port": PORT,
                "ui_port": {{ dashboard_ui_port }},
                "services": SERVICES,
            })
            return
        self._send(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        return

def main():
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.serve_forever()

if __name__ == "__main__":
    main()