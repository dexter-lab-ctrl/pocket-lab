#!/usr/bin/env python3
import sys
import os
import json
import time
import yaml
import subprocess
from pathlib import Path

# Paths synchronized with pocket_lab_api_server.py
API_DIR = Path(os.path.expanduser("~/api"))
OPA_LOG_PATH = API_DIR / "opa_evaluations.json"
OPA_CONFIG_PATH = API_DIR / "opa_config.json"
POLICIES_DIR = os.path.expanduser("~/pocket_lab_policies")

def log_eval(trigger, status, msg, duration):
    logs = []
    if OPA_LOG_PATH.exists():
        try:
            logs = json.loads(OPA_LOG_PATH.read_text())
        except: pass
    
    # Generate log format expected by PolicyGuardrailsTab.jsx
    eval_record = {
        "id": os.urandom(4).hex(),
        "timestamp": time.strftime("%I:%M:%S %p"),
        "trigger": trigger,
        "status": status,
        "msg": msg,
        "time": duration
    }
    
    # Prepend and keep only the latest 50 logs
    logs.insert(0, eval_record)
    OPA_LOG_PATH.write_text(json.dumps(logs[:50], indent=2))

def main():
    if len(sys.argv) < 2:
        print("Usage: opa_interceptor.py <playbook.yml>")
        sys.exit(1)
        
    playbook_path = sys.argv[1]
    start_time = time.time()
    
    # 1. Read Enforcement Mode set by the UI
    enforce_mode = False
    if OPA_CONFIG_PATH.exists():
        try:
            enforce_mode = json.loads(OPA_CONFIG_PATH.read_text()).get("enforce_mode", False)
        except: pass

    # 2. Parse YAML Playbook to JSON for OPA
    try:
        with open(playbook_path, 'r') as f:
            playbook_data = yaml.safe_load(f)
    except Exception as e:
        print(f"Failed to parse playbook: {e}")
        sys.exit(1)

    input_json = json.dumps({"playbook": playbook_data})

    # 3. Execute OPA Engine
    cmd = [
        "opa", "eval", "--format", "json",
        "-d", POLICIES_DIR,
        "-I", "data.pocketlab"
    ]
    
    result = subprocess.run(cmd, input=input_json.encode(), capture_output=True)
    duration = int((time.time() - start_time) * 1000)
    
    try:
        opa_output = json.loads(result.stdout)
        
        # Collect any "deny" messages from all policy namespaces
        denies = []
        if "result" in opa_output and len(opa_output["result"]) > 0:
            value = opa_output["result"][0].get("expressions", [])[0].get("value", {})
            for namespace, rules in value.items():
                if "deny" in rules and len(rules["deny"]) > 0:
                    denies.extend(rules["deny"])
                        
        if denies:
            msg = denies[0] # Take the first critical violation
            status = "DENIED" if enforce_mode else "AUDIT_WARN"
            log_eval("ansible_playbook_deploy", status, msg, duration)
            
            print(f"\n[OPA] ⚠️ POLICY VIOLATION: {msg}")
            if enforce_mode:
                print("[OPA] 🚫 ENFORCEMENT MODE ACTIVE: Deployment Blocked.")
                sys.exit(1)
            else:
                print("[OPA] ⚠️ AUDIT MODE: Proceeding with deployment despite warnings...\n")
        else:
            log_eval("ansible_playbook_deploy", "PASS", "Policy Guardrails Passed. No violations.", duration)
            print("\n[OPA] ✅ All policies passed.\n")
            
    except Exception as e:
        print(f"[OPA] Evaluation engine failed: {e}")
        
    # 4. Proceed with standard Ansible execution if not blocked
    os.execvp("ansible-playbook", ["ansible-playbook", playbook_path])

if __name__ == "__main__":
    main()