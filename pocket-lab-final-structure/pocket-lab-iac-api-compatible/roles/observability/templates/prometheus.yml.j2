global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:{{ observability_prometheus_port }}"]

  - job_name: "pm2_bridge_services"
    static_configs:
      - targets:
        - "localhost:{{ observability_grafana_port }}"
        - "localhost:{{ observability_loki_port }}"

  - job_name: "vault"
    metrics_path: "/v1/sys/metrics"
    params:
      format: ['prometheus']
    static_configs:
      - targets: ["127.0.0.1:8200"]
    # [THE FIX]: Relies on the unauthenticated_metrics_access = true
    # flag we injected in Day-0 Vault setup to scrape Vault metrics without hitting 403s!
