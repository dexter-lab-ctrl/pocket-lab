:{{ caddy_public_port }} {
    header {
        Strict-Transport-Security "max-age={{ caddy_hsts_max_age }}; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    encode zstd gzip
    handle /healthz {
        respond "ok" 200
    }
    handle /api/* {
        reverse_proxy {{ caddy_routes.api }}
    }
    handle /loki/* {                           
        reverse_proxy {{ caddy_routes.loki }}
    }                                          
    handle /* {
        reverse_proxy {{ caddy_routes.ui }}
    }
}