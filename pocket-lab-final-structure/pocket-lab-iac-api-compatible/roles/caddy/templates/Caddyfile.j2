{% if caddy_tailscale_fqdn | length > 0 %}
{{ caddy_tailscale_fqdn }} {
    tls {
        get_certificate tailscale
    }
{% else %}
:{{ caddy_public_port }} {
{% endif %}
    header {
        Strict-Transport-Security "max-age={{ caddy_hsts_max_age }}; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    encode zstd gzip

    handle /health {
        reverse_proxy {{ caddy_routes.api }}
    }

    handle /ready {
        reverse_proxy {{ caddy_routes.api }}
    }

    handle /healthz {
        reverse_proxy {{ caddy_routes.api }}
    }

    handle /api/* {
        reverse_proxy {{ caddy_routes.api }}
    }

    handle /ws/* {
        reverse_proxy {{ caddy_routes.api }}
    }

    handle /gitea/* {
        reverse_proxy {{ caddy_routes.gitea }}
    }

    handle /loki/* {
        reverse_proxy {{ caddy_routes.loki }}
    }

    handle /gatus/* {
        reverse_proxy {{ caddy_routes.gatus }}
    }

    # Day-3 Static PWA Serving
    handle /* {
        root * {{ caddy_pwa_dir }}
        try_files {path} /index.html
        file_server
    }
}
